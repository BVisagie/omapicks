{
  "schemaVersion": 1,
  "types": [
    {
      "id": "system-monitor",
      "name": "System Monitor",
      "description": "CPU, memory, temperature, and resource monitoring",
      "include": ["\\b(system|resource|hardware) monitor\\b", "\\b(cpu|processor|ram|memory|temperature|thermals?)\\b", "\\b(btop|htop|nvtop)\\b"],
      "exclude": ["\\bkeyboard\\b", "\\bkeybind", "\\b(color|night[- ]light|ferment) temperature\\b"]
    },
    {
      "id": "vpn",
      "name": "VPN",
      "description": "VPN status, connection, and privacy controls",
      "include": ["vpn\\b", "\\b(wireguard|tailscale|mullvad|windscribe|cloudflare warp)\\b"]
    },
    {
      "id": "mail",
      "name": "Mail",
      "description": "Unread mail, inbox, and email shortcuts",
      "include": ["\\b(e-?mail|mailbox|gmail|imap|thunderbird|fastmail)\\b", "\\boutlook mail\\b"],
      "exclude": ["\\bminimap\\b"]
    },
    {
      "id": "music",
