      "exclude": ["\\b(display|monitor) (manager|configuration|config|profiles?|layouts?)\\b", "\\b(monitor layout|refresh rate|display arrangement)\\b", "\\b(keyboard|key light|smart lights?|rgb|openrgb|wled|govee|wiz lights?|hue lights?|peripherals?)\\b"]
    },
    {
