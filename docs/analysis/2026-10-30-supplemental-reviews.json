    {
      "pluginId": "air.auto-cafe",
      "name": "Auto Cafe",
      "typeId": "keep-awake",
      "decision": "qualified",
      "scenario": "Keep the desktop awake for a fullscreen/game/media activity and resume the prior policy when the activity finishes.",
      "capabilities": [
        "inhibit-idle",
        "resume-idle-policy"
      ],
      "scope": [
        "Automatic hold triggered by fullscreen windows, detected games or active MPRIS playback. Clicking its indicator toggles automation, not the current hold.",
        "The documented scope prevents idle locking through the built-in Stay Awake service. This review does not establish whether it also prevents display blanking or every suspend path.",
        "Turning off its automation does not itself clear the current Stay Awake state; manually enabled Stay Awake is preserved."
      ],
      "reason": "Engages Stay Awake while fullscreen windows, detected games or MPRIS playback are active and releases holds it owns after those conditions end.",
