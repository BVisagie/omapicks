{
  "name": "omapicks",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Independent weekly rankings for Omarchy plugins",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "node build/index.mjs",
    "refresh": "node build/refresh.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && node build/index.mjs",
    "traffic": "node scripts/report-traffic.mjs",
    "test:e2e": "playwright test",
    "audit:classification": "node scripts/classification-audit.mjs",
    "compare:methodology": "node scripts/compare-methodologies.mjs",
    "compare:task-fit": "node scripts/compare-task-fit.mjs",
    "review:tasks": "node scripts/task-review.mjs",
    "availability": "node build/availability.mjs",
    "review:evidence": "node scripts/review-evidence.mjs",
    "lint:workflows": "bash scripts/lint-workflows.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2"
  }
}
